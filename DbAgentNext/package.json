{
    "name": "svt-db-agent-next",
    "version": "0.0.1",
    "description": "SVT DB Agent, NestJS re-implementation of DbAgent/ (C++)",
    "private": true,
    "scripts": {
        "start": "nest start --watch",
        "start:prod": "node dist/main.js",
        "build": "nest build",
        "lint": "eslint . --quiet",
        "lint:fix": "eslint . --quiet --fix",
        "lint-staged": "lint-staged",
        "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p src/db/tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "e2e": "vitest run --config vitest.e2e.config.ts",
        "parity:record": "vitest run --config vitest.parity.config.ts record.parity-spec",
        "parity:compare": "vitest run --config vitest.parity.config.ts compare.parity-spec",
        "db:migration:create": "mikro-orm migration:create",
        "db:migration:up": "mikro-orm migration:up",
        "db:migration:down": "mikro-orm migration:down",
        "db:migration:pending": "mikro-orm migration:pending",
        "db:schema:update:dump": "mikro-orm schema:update --dump --safe",
        "pre-pull-request": "npm run lint && npm run typecheck && npm test",
        "next-preminor-version": "npm version preminor --preid=SNAPSHOT",
        "next-snapshot-version": "npm version prerelease --preid=SNAPSHOT",
        "next-major-version": "npm version major",
        "next-minor-version": "npm version minor",
        "next-patch-version": "npm version patch",
        "version": "echo $npm_package_version"
    },
    "dependencies": {
        "@mikro-orm/core": "7.2.8",
        "@mikro-orm/decorators": "7.2.8",
        "@mikro-orm/migrations": "7.2.8",
        "@mikro-orm/nestjs": "7.1.0",
        "@mikro-orm/postgresql": "7.2.8",
        "@nestjs/common": "11.0.12",
        "@nestjs/config": "4.0.2",
        "@nestjs/core": "11.0.12",
        "@nestjs/microservices": "11.0.12",
        "@nestjs/platform-express": "11.0.12",
        "@nestjs/terminus": "11.1.1",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.1",
        "kafkajs": "2.2.4",
        "reflect-metadata": "0.1.14",
        "rxjs": "7.8.2"
    },
    "devDependencies": {
        "@eslint/js": "9.16.0",
        "@mikro-orm/cli": "7.2.8",
        "@mikro-orm/reflection": "7.2.8",
        "@nestjs/cli": "11.0.24",
        "@nestjs/testing": "11.0.12",
        "@stylistic/eslint-plugin": "2.12.1",
        "@swc-node/register": "1.12.1",
        "@swc/core": "1.16.2",
        "@types/node": "20.19.43",
        "dotenv": "16.4.7",
        "eslint": "9.39.5",
        "eslint-plugin-import": "2.31.0",
        "eslint-plugin-unused-imports": "4.1.4",
        "lint-staged": "15.2.11",
        "ts-loader": "9.6.2",
        "typescript": "5.9.3",
        "typescript-eslint": "8.70.0",
        "unplugin-swc": "2.0.0",
        "vitest": "4.1.11"
    },
    "engines": {
        "node": "^22.17.0 || >=24.0.0",
        "npm": ">=10.8.0"
    },
    "mikro-orm": {
        "preferTs": true,
        "tsConfigPath": "./tsconfig.mikro-orm.json",
        "configPaths": [
            "./mikro-orm.config.ts"
        ]
    }
}
