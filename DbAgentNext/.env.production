# Production values come from the container environment (Environment/*/docker-compose-svtsw-*.yml).
# The required keys are listed here for documentation only; a missing or empty one fails the boot.
SVT_DB_AGENT_DB_HOST=
SVT_DB_AGENT_DB_PORT=
SVT_DB_AGENT_DB_USER=
SVT_DB_AGENT_DB_PASS=
SVT_DB_AGENT_DB_NAME=
SVT_DB_AGENT_DB_SCHEMA=
SVT_DB_AGENT_KAFKA_SERVER=
SVT_DB_AGENT_KAFKA_PORT=
# Optional: SVT_DB_AGENT_LOGGER_TERM_VERBOSITY=PRODUCTION|STANDARD|VERBOSE|DEBUG (default STANDARD),
#           SVT_DB_AGENT_HTTP_PORT (default 7676), SVT_DB_AGENT_LOGGER_FILE_PATH, SVT_DB_AGENT_LOGGER_FILE_VERBOSITY (accepted, unused),
#           SVT_DB_AGENT_FEATURE_CHIP_BLOCKS=true|false (default false: chip blocks are not generated with a new chip).
