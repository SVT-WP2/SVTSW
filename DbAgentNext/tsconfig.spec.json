{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": [
            "vitest/globals",
            "node"
        ]
    },
    "include": [
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.d.ts",
        "test-e2e/**/*.ts",
        "test-parity/**/*.ts",
        "vitest.config.ts",
        "vitest.e2e.config.ts",
        "vitest.parity.config.ts",
        "vitest.shared.ts"
    ],
    "exclude": [
        "src/db/**/*.spec.ts"
    ]
}
