# versions.env - deployment manifest of the DEV environment: the image tag of
# EVERY service that runs here. TEMPLATE - the real file lives at:
#     /opt/docker/svtsw/dev/versions.env
#
# The CI deploy (Environment/deploy-service.sh) rewrites exactly one line per
# deployment (e.g. SVT_UI_VERSION=<new tag>) and recreates only that service.
# On reboot the systemd units bring the stack up with exactly these versions.
#
# Roll back = set the wanted tag here, then (from /opt/docker/svtsw/dev):
#   docker compose -p svt-svtsw--dev --env-file .env --env-file versions.env \
#     -f docker-compose-svtsw-dev.yml up -d --no-deps svt-ui

# --- application services (rewritten by CI deploys) ---------------------------
# `dev` is only the bootstrap tag (the latest master build); from the first
# pipeline deploy on, these hold a pinned tag (short commit SHA or release
# version, e.g. 1a2b3c4d or 1.4.0).
SVT_UI_VERSION=dev
SVT_DB_AGENT_VERSION=dev

# --- infrastructure (hand-pinned, applied on kafka stack restart) -------------
KAFKA_VERSION=7.4.0
KAFKA_UI_VERSION=latest
