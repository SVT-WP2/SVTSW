[Unit]
Description=Kafka Stack for SVTSW Dev Environment
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root

# Everything for this environment lives here: the compose files (synced from
# git by CI deploys), .env (config + secrets, admin-managed) and versions.env
# (image pins, CI-managed).
WorkingDirectory=/opt/docker/svtsw/dev

# -p pins the Compose project name; it must match `name:` in the compose file
# so this unit, CI deploys and manual runs all manage the same project.
# '-' prefix on pull => non-fatal: a registry hiccup won't block startup.
ExecStartPre=-/bin/docker compose -p svt-kafka--dev \
    --env-file /opt/docker/svtsw/dev/.env \
    --env-file /opt/docker/svtsw/dev/versions.env \
    -f /opt/docker/svtsw/dev/docker-compose-kafka-dev.yml pull

ExecStart=/bin/docker compose -p svt-kafka--dev \
    --env-file /opt/docker/svtsw/dev/.env \
    --env-file /opt/docker/svtsw/dev/versions.env \
    -f /opt/docker/svtsw/dev/docker-compose-kafka-dev.yml up -d --remove-orphans

ExecStop=/bin/docker compose -p svt-kafka--dev \
    --env-file /opt/docker/svtsw/dev/.env \
    --env-file /opt/docker/svtsw/dev/versions.env \
    -f /opt/docker/svtsw/dev/docker-compose-kafka-dev.yml down

Restart=on-failure
RestartSec=10s
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
