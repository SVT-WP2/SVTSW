# SVTSW PROD environment - configuration & secrets. TEMPLATE.
#
# The real file lives ONLY on the server (never in git, never touched by CI):
#     /opt/docker/svtsw/prod/.env         (root-owned, chmod 600)
#
# It is read via `--env-file` by BOTH stacks of the environment
# (docker-compose-kafka-prod.yml and docker-compose-svtsw-prod.yml).
#
# Values that used to live in GitHub (Settings -> Environments -> prod) move
# here 1:1:
#     vars.SVT_KAFKA_HOST   -> SVT_KAFKA_HOST
#     vars.SVT_KAFKA_PORT   -> SVT_KAFKA_PORT
#     vars.SVT_UI_PORT      -> SVT_UI_PORT
#     vars.SVT_DB_HOST      -> SVT_DB_HOST
#     vars.SVT_DB_PORT      -> SVT_DB_PORT
#     secrets.SVT_DB_USER   -> SVT_DB_USER
#     secrets.SVT_DB_PASS   -> SVT_DB_PASS
#     secrets.SVT_DB_NAME   -> SVT_DB_NAME
#     secrets.SVT_DB_SCHEMA -> SVT_DB_SCHEMA
#
# Quote values containing spaces or shell-special characters in single quotes:
#     SVT_DB_PASS='p@ss w0rd'

# --- Kafka, as seen by the app services ---------------------------------------
# The app containers share the svt-network--prod network with the broker, so the
# in-network address is the right one: the `kafka` alias + INSIDE listener port.
SVT_KAFKA_HOST=kafka
SVT_KAFKA_PORT=9094

# --- Kafka broker stack (docker-compose-kafka-prod.yml) -----------------------
# Public address advertised on the OUTSIDE listener (this host's public IP).
KAFKA_ADVERTISED_HOST=128.141.22.7
# Host-side ports; defaults shown, uncomment to override.
#KAFKA_PORT_INSIDE=9090
#KAFKA_PORT_TUNNEL=9091
#KAFKA_PORT_OUTSIDE=9092
#KAFKA_UI_PORT=8088
# KRaft cluster id - must stay stable for the lifetime of the data volume and
# must differ between dev and prod.
#KAFKA_CLUSTER_ID=UHJvZEthZmthQ2x1c3RyMQ

# --- UI -----------------------------------------------------------------------
SVT_UI_PORT=80

# --- Database (svt-db-agent) - SECRETS, fill these in -------------------------
SVT_DB_HOST=
SVT_DB_PORT=5432
SVT_DB_USER=
SVT_DB_PASS=
SVT_DB_NAME=
SVT_DB_SCHEMA=
