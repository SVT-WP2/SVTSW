# versions.env - deployment manifest of the PROD environment: the image tag of
# EVERY service that runs here. TEMPLATE - the real file lives at:
#     /opt/docker/svtsw/prod/versions.env
#
# The CI deploy (Environment/deploy-service.sh) rewrites exactly one line per
# deployment (e.g. SVT_UI_VERSION=<new tag>) and recreates only that service.
# On reboot the systemd units bring the stack up with exactly these versions.
#
# Roll back = set the wanted tag here, then (from /opt/docker/svtsw/prod):
#   docker compose -p svt-svtsw--prod --env-file .env --env-file versions.env \
#     -f docker-compose-svtsw-prod.yml up -d --no-deps svt-ui

# --- application services (rewritten by CI deploys) ---------------------------
# `latest` is only the bootstrap value - replace it with the explicit release
# versions you want in prod (e.g. 1.4.0) when creating the real file. Every
# prod deploy from the pipeline pins an explicit release version here.
SVT_UI_VERSION=latest
SVT_DB_AGENT_VERSION=latest

# --- infrastructure (hand-pinned, applied on kafka stack restart) -------------
KAFKA_VERSION=7.4.0
KAFKA_UI_VERSION=latest
