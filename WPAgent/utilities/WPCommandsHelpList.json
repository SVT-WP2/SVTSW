{
  "Initialize": {
    "description": "Initialize connection to the wafer prober (manual or database-driven)",
    "category": "Setup",
    "parameters": {
      "address": {
        "required": "conditional",
        "type": "string",
        "description": "Prober network address (required for manual mode)"
      },
      "machine_type": {
        "required": "conditional",
        "type": "string",
        "description": "Type of prober ('sentio', required for manual mode)"
      },
      "project_name": {
        "required": "conditional",
        "type": "string",
        "description": "Optional project name"
      },
      "alignment_die": {
        "required": false,
        "type": "string",
        "description": "Alignment die position as 'col,row,subsite' (e.g., '5,10,0')"
      },
      "home_die": {
        "required": false,
        "type": "string",
        "description": "Home die position as 'col,row,subsite' (e.g., '1,1,0')"
      },
      "force": {
        "required": false,
        "type": "boolean",
        "description": "Force re-initialization (default: false)"
      },
      "with_db": {
        "required": false,
        "type": "boolean",
        "description": "Use database for initialization (interactive)"
      }
    },
    "example": "python main.py send Initialize --params='{\"address\":\"wpmit01.cern.ch:35555\",\"machine_type\":\"sentio\"}'",
    "example_with_dies": "python main.py send Initialize --params='{\"address\":\"wpmit01.cern.ch:35555\",\"machine_type\":\"sentio\",\"alignment_die\":\"5,10,0\",\"home_die\":\"1,1,0\"}'",
    "example_db": "python main.py send Initialize --params='{\"with_db\":true}'",
    "execution_time": "< 1 second (manual) or 5-30 seconds (database)",
    "notes": "Two modes: (1) Manual - provide address, machine_type, and optionally die positions, (2) Database - interactive selection of prober, ASIC family, orientation, and project (die positions set automatically)"
  },

  "Load": {
    "description": "Load a wafer onto the chuck",
    "category": "Wafer Handling",
    "parameters": {},
    "example": "python main.py send Load",
    "execution_time": "30-60 seconds"
  },

  "Unload": {
    "description": "Unload the wafer from the chuck",
