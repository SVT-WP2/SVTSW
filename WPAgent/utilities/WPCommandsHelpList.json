  },

  "FindHome": {
    "description": "Find the home position of the chuck. Uses home die from initialization if not specified.",
    "category": "Positioning",
    "parameters": {
      "home_die_col": {
        "required": false,
        "type": "int",
        "description": "Home die column (optional if set during initialization)"
      },
      "home_die_row": {
        "required": false,
        "type": "int",
        "description": "Home die row (optional if set during initialization)"
      },
      "subsite": {
        "required": false,
        "type": "int",
        "description": "Subsite index (default: 0)"
      }
    },
    "example": "python main.py send FindHome",
    "example_with_params": "python main.py send FindHome --params='{\"home_die_col\":1,\"home_die_row\":1}'",
    "execution_time": "10-20 seconds",
    "notes": "If home_die was set during initialization, it will automatically use that position. Otherwise performs default FindHome."
  },

