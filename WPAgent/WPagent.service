[Unit]
Description=Wafer Prober agent
Requires=kafka.service

[Service]
Type=simple
User=root

WorkingDirectory=/data/SVTSoftware/SVTSW/WPAgent
ExecStart=/usr/local/bin/python3.12 /data/SVTSoftware/SVTSW/WPAgent/main.py listen CERN

Restart=always
TimeoutStartSec=2
RestartSec=2
LimitMEMLock=infinity

[Install]
WantedBy=default.target