{
  "PowerRampUp": {
    "inputMessage": {
      "command": "RunTest: New",           // UI
      "testId": 101,                       // UI + DB (unique identifier)
      "data": {                            // UI fetched from DBAgent
        "chipId": 0,                       // DBAgent
        "testSetupId": 0,                  // DBAgent
        "configId": 0,                     // DBAgent
        "params": {
          "chipName": "SLDO",              // Selected on UI
          "testName": "PowerRampUp",       // Selected on UI
          "testConfiguration": {           // Entered on UI OR fetched from DBAgent
            "mode": 0,
            "loadCapacitance": 10,
            "loadCurrent": 40,
            "temperature": 25
          },
          "inputs": {                      // Entered on UI
            "vInTarget": 1.5,
            "iInLimit": 1.5,
            "rampRate": 3.1
          }
        }
      }
    },
    "outputMessage": {
      "type": "RunTestReply",              // Generated by TestAgent
      "testStatus": "TestSuccess",         // Generated by TestAgent
      "testValues": {                      // Generated by TestAgent
        "inputs": {
          "vInTarget": 1.5,
          "iInLimit": 1.5,
          "rampRate": 3.1
        },
        "outputs": {
          "vOut": 1.3
        }
      },
      "testId": "101"                      // Echoed back by TestAgent (string)
    }
  }
},





