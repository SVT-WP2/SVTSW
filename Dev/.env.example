# SVTSW local dev environment - environment variables.
#
# Copy this file to ".env" in this same folder and adjust if needed:
#     Copy-Item .env.example .env
# Docker Compose loads ".env" automatically when you run commands from this folder.
#
# The DEFAULTS below already match Setup A (containerised Postgres from
# docker-compose.postgres.yml). For Setup A you can even run without any .env file.

# --- Database (svt-db-agent + containerised Postgres) --------------------------
# Setup A (containerised Postgres): keep the defaults below.
# Setup B (native Postgres on your host): set DB_HOST=host.docker.internal and DB_PASS.
DB_HOST=postgres-db--local
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=svt_sw_db

# --- Kafka --------------------------------------------------------------------
KAFKA_SERVER=kafka
KAFKA_PORT=9084
# Max size of a single Kafka message, in bytes (default here: 50 MiB).
# Kafka's own default is 1 MB - too small for list replies (wafers, chips, ...).
# Raising this above 209715200 also means raising KAFKA_SOCKET_REQUEST_MAX_BYTES
# and KAFKA_FETCH_MAX_BYTES in docker-compose.kafka-local.yml.
KAFKA_MAX_MESSAGE_BYTES=52428800

# --- UI -----------------------------------------------------------------------
UI_PORT=7575
