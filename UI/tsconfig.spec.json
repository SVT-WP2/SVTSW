{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./out-tsc/spec",
        "types": [
            "vitest/globals",
            "node"
        ],
        "moduleResolution": "bundler"
    },
    "include": [
        "test-setup.ts",
        "apps/**/*.spec.ts",
        "apps/**/*.test.ts",
        "apps/**/*.d.ts",
        "libs/**/*.spec.ts",
        "libs/**/*.test.ts",
        "libs/**/*.d.ts"
    ]
}
