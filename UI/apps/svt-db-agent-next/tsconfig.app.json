{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "skipLibCheck": true,
        "types": [
            "node"
        ],
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "target": "es2021"
    },
    "include": [
        "src/**/*.ts",
        "mikro-orm.config.ts"
    ],
    "exclude": [
        "src/**/*.spec.ts",
        "src/**/*.test.ts"
    ]
}
