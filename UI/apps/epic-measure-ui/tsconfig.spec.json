{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "moduleResolution": "bundler",
        "types": [
            "vitest/globals",
            "node"
        ],
        "module": "preserve",
        "isolatedModules": true
    },
    "include": [
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.d.ts"
    ]
}
