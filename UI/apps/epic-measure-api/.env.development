KAFKA_BROKER=localhost:9085
SVT_UI_API_PORT=7373

# The key of the session tokens (EpicAuthGuard). FOR DEVELOPMENT ONLY: this file is in git, so the value protects
# nothing, and the BFF refuses it when NODE_ENV is production (prefix DEVELOPMENT-ONLY-). A server sets its own
# random value in its .env (Environment/README.md).
SVT_UI_AUTH_SECRET=DEVELOPMENT-ONLY-not-a-secret-every-clone-has-it
