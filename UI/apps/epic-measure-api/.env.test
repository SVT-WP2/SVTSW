# The e2e suite of epic-measure-api (test-e2e/, `npx nx e2e epic-measure-api`). Personal overrides go into
# .env.test.local next to this file (git-ignored); variables already set in the shell win over both.

# The dedicated e2e broker of ../../../Dev/docker-compose.e2e.yml: never the dev broker (9085), whose fixed consumer
# groups a running dev agent or dev BFF would share with the suite.
KAFKA_BROKER=localhost:9185
SVT_UI_API_PORT=9393

# The database the harness hands DbAgentNext (on the Postgres of Dev/docker-compose.postgres.yml). Created if
# missing, migrated with the agent's migrations, and truncated before every test: the name must end with _e2e_test.
EPIC_API_E2E_DB_HOST=localhost
EPIC_API_E2E_DB_PORT=5500
EPIC_API_E2E_DB_USER=postgres
EPIC_API_E2E_DB_PASS=postgres
EPIC_API_E2E_DB_NAME=svt_sw_db_api_e2e_test

# The agent's HTTP port (GET /health): readiness probe of the child process; not 7676 (dev) or 7677 (agent e2e).
EPIC_API_E2E_AGENT_HTTP_PORT=7678

# The key of the session tokens. FOR DEVELOPMENT AND TESTS ONLY: this file is in git, so the value protects nothing.
SVT_UI_AUTH_SECRET=DEVELOPMENT-ONLY-e2e-not-a-secret-every-clone-has-it
