{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "skipLibCheck": true,
        "module": "es2022",
        "moduleResolution": "bundler",
        "importHelpers": false,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "resolveJsonModule": true,
        "typeRoots": [
            "../../node_modules/@types",
            "../../node_modules"
        ],
        "types": [
            "vitest/globals",
            "node"
        ]
    },
    "include": [
        "test-e2e/**/*.ts",
        "vitest.e2e.config.ts"
    ]
}
