{
    "name": "epic-measure-api",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/epic-measure-api/src",
    "projectType": "application",
    "tags": [],
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "command": "webpack-cli build",
                "args": [
                    "node-env=production"
                ]
            },
            "configurations": {
                "development": {
                    "args": [
                        "node-env=development"
                    ]
                }
            }
        },
        "serve": {
            "executor": "@nx/js:node",
            "defaultConfiguration": "development",
            "dependsOn": [
                "build"
            ],
            "options": {
                "buildTarget": "epic-measure-api:build",
                "runBuildTargetDependencies": false
            },
            "configurations": {
                "development": {
                    "buildTarget": "epic-measure-api:build:development"
                },
                "production": {
                    "buildTarget": "epic-measure-api:build:production"
                }
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vitest run --dir apps/epic-measure-api",
                "cwd": "{workspaceRoot}"
            }
        },
        "e2e": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "commands": [
                    "tsc -p apps/epic-measure-api/tsconfig.e2e.json",
                    "vitest run --config apps/epic-measure-api/vitest.e2e.config.ts"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            }
        }
    }
}
