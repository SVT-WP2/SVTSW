{
    "name": "epic-measure-ui",
    "version": "0.1.2",
    "scripts": {
        "ng": "ng",
        "start": "nx run-many -t=serve -p epic-measure-api epic-measure-ui",
        "start::ui": "nx serve epic-measure-ui --skip-nx-cache",
        "start::ui::prod": "nx serve epic-measure-ui --configuration production",
        "start::api": "nx serve epic-measure-api",
        "start::api::prod": "nx serve epic-measure-api --configuration production",
        "start::db-agent": "nx serve epic-db-agent",
        "build::ui": "nx build epic-measure-ui",
        "build::api": "nx build epic-measure-api",
        "build::db-agent": "nx build epic-db-agent",
        "build::all": "nx run-many --target=build -p epic-measure-ui epic-measure-api",
        "test": "jest --passWithNoTests",
        "lint": "npm run lint:ts && npm run lint:styles",
        "lint-staged": "lint-staged",
        "lint:fix": "npm run lint:ts:fix && npm run lint:styles:fix",
        "lint:ts": "eslint \"apps/**/src/**/*.ts\" \"apps/**/src/**/*.component.html\" \"libs/**/*.ts\" \"libs/**/*.component.html\" --quiet",
        "lint:ts:fix": "eslint \"apps/**/src/**/*.ts\" \"apps/**/src/**/*.component.html\" \"libs/**/*.ts\" \"libs/**/*.component.html\" --quiet --fix",
        "lint:styles": "stylelint \"apps/**/src/**/*.scss\" \"libs/**/*.scss\"",
        "lint:styles:fix": "stylelint \"apps/**/src/**/*.scss\" \"libs/**/*.scss\" --fix",
        "pre-pull-request": "npm run lint && npm run test",
        "install-deps": "npm i --force",
        "prepare": "cd .. && husky ./UI/.husky",
        "next-preminor-version": "npm version preminor --preid=SNAPSHOT",
        "next-snapshot-version": "npm version prerelease --preid=SNAPSHOT",
        "next-major-version": "npm version major",
        "next-minor-version": "npm version minor",
        "next-patch-version": "npm version patch",
        "version": "echo $npm_package_version"
    },
    "private": true,
